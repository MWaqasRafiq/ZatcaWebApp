@page
@using System.Data;
@model ZatcaWebApp_V2.Pages.InvoicesModel
@{
    ViewData["Title"] = "Invoice Report";
    Layout = "_Layout";
}
@Html.AntiForgeryToken()

<div class="container-fluid overflow-auto pt-2" style="padding-right: 5rem;">
    <div class="row gy-4">
        <div class="col-lg-12">
            <div class="card mb-0">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table mb-0 table-striped table-hover w-100 wrap" style="font-size: 12px;word-wrap: break-word; word-break: break-all;" id="InvoicesTable">
                            <thead>
                                <tr>
                                    @foreach (DataColumn column in Model.invoicesViewModel[0].Columns)
                                    {
                                        if (@column.ColumnName.ToLower() != "totalrows")
                                        {
                                            <th>@column.ColumnName</th>
                                        }
                                    }
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    @foreach (DataColumn column in Model.invoicesViewModel[0].Columns)
                                    {
                                        if (@column.ColumnName.ToLower() != "totalrows")
                                        {
                                            <th>@column.ColumnName</th>
                                        }
                                    }
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

