@page
@using System.Data;
@model ZatcaWebApp_V2.Pages.InvoicesModel
@{
    ViewData["Title"] = "Invoice Report";
    Layout = "_Layout";
}
@Html.AntiForgeryToken()
@* <partial name="~/Pages/Shared/_InvoiceTable.cshtml" /> *@

<div class="overflow-auto pb-0 pt-0 w-100" style="padding-right: 6rem;">
    <section class="pb-2 pt-3">
        <div style="text-align:right" class="container-fluid">
            <button type="button" id="btn_filters" class="btn btn-info" data-toggle="collapse" data-target="#demo">Filters</button>
            <div id="demo" class="collapse card mb-0 mt-2" style="text-align:left">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label class="control-label" for="ddlVAT">VAT No</label>
                                @Html.DropDownList("Dropwonlist", (IEnumerable<SelectListItem>)Model.VatNo,
                                new { @class = "form-control input-sm",id="ddlVAT"})
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label class="control-label" for="FromDate">From Date</label>
                                <div class="input-group">
                                    <input id="FromDate" placeholder="DD/MM/YYYY" asp-for="invoicesVM.FromDate" type="text" class="datePicker form-control">
                                    <div class="input-group-append">
                                        <label class="input-group-text" for="FromDate">
                                            <i class="fa fa-calendar" style="font-size: x-large;" aria-hidden="true"></i>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label class="control-label" for="FromDate">To Date</label>
                                <div class="input-group">
                                    <input id="ToDate" placeholder="DD/MM/YYYY" asp-for="invoicesVM.ToDate" type="text" class="datePicker form-control">
                                    <div class="input-group-append">
                                        <label class="input-group-text" for="ToDate">
                                            <i class="fa fa-calendar" style="font-size: x-large;" aria-hidden="true"></i>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <button type="button" class="btn btn-warning" id="sub_button">Submit</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="tables pt-2" id="sectionForInvoice"></section>

</div>

