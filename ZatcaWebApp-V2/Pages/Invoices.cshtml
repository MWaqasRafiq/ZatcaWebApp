<script src="https://code.jquery.com/jquery-3.6.0.min.js"
        integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
        crossorigin="anonymous"></script>
<script>
    $('ul#exampledropdownDropdown li:nth-child(1)').addClass("active");
    $('#PageheadGeneral').text('Invoices');

    $(document).ready(function () {

        $(function () {
            $(".datePicker").datepicker({
                dateFormat: 'dd/mm/y',//check change
                changeMonth: true,
                changeYear: true
            });
        });
    
        $("#sub_button").click(function () {
            var invoices = {
                // VatNo: $('#ddlVAT').val(),
                FromDate: $('#FromDate').val(),
                ToDate: $('#ToDate').val(),
            };
            var json = JSON.stringify(invoices);

            debugger;
            $.ajax({
                type: "POST",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN",
                        $('input:hidden[name="__RequestVerificationToken"]').val());
                },
                url: "/Invoices?handler=InvoicePartial",
                data: invoices,
                success: function (data) {
                    console.log(data)
                    $('#btn_filters').trigger('click');
                    $("#sectionForInvoice").html(data);
                }
            });
        });

        $('#InvoicesTable').DataTable({
            "serverSide": true,
            "proccessing": true,
            "paging": true, 
            "pagingType": 'full_numbers',
            "pageLength": 5,
            "lengthMenu": [5, 10, 20, 50, 100],
            "ajax": {
                url: "/Invoices?handler=InvoiceData",
                type: 'GET', 
                // contentType: "application/json",
                 // dataType: "json",
                headers: { 'RequestVerificationToken': $('@Html.AntiForgeryToken()').val() }
            }, 
            "language": {
                processing: '<i class="fa fa-spinner fa-spin fa-3x fa-fw"></i>Processing...'
            },
            "columnDefs": [
                // {
                //     "targets": -1,
                //     "data": null,
                //     "render": function (data, type, row, meta) {
                //         return '<a href="/customers/edit?id=' + row.id + '">Edit</a> | <a href="/customers/details?id=' + row.id + '">Details</a> | <a href="/customers/delete?id=' + row.id + '">Delete</a>';
                //     },
                //     "sortable": false
                // },
                { "searchable": true, "orderable": true, "name": "irn", "data": "irn", "targets": 0, "width": "40px", "visible": true },
                { "searchable": true, "orderable": true, "name": "uuid", "data": "uuid", "width": "40px", "targets": 1 },
                { "searchable": true, "orderable": true, "name": "xmlFileName", "data": "xmlFileName", "width": "40px", "targets": 2 },
                // { "name": "TaxTotal", "data": "TaxTotal", "targets": 3 },
                { "searchable": true, "orderable": true, "name": "docType", "data": "docType", "width": "30px", "targets": 3 },
                { "searchable": true, "orderable": true, "name": "action", "data": "action", "width": "30px", "targets": 4 },
                { "searchable": true, "orderable": true, "name": "actionStatus", "data": "actionStatus", "targets": 5 },
                { "searchable": true, "orderable": true, "name": "transactionDate", "data": "transactionDate", "targets": 6 },
                { "searchable": true, "orderable": true, "name": "storeNo", "data": "storeNo", "targets": 7 },
                { "searchable": true, "orderable": true, "name": "terminalNo", "data": "terminalNo", "targets": 8 },
                { "searchable": true, "orderable": true, "name": "trxNo", "data": "trxNo", "targets": 9 },
                { "searchable": true, "orderable": true, "name": "timeleftToReport", "data": "timeleftToReport", "targets": 10 },
                { "searchable": true, "orderable": true, "name": "reportedIn", "data": "reportedIn", "targets": 11 },
                { "searchable": true, "orderable": true, "name": "source", "data": "source", "targets": 12 },
                { "searchable": true, "orderable": true, "name": "actionCount", "data": "actionCount", "targets": 13 },
                { "searchable": true, "orderable": true, "name": "errorCount", "data": "errorCount", "targets": 14 },
                { "searchable": true, "orderable": true, "name": "warningCount", "data": "warningCount", "targets": 15 },
                { "searchable": true, "orderable": true, "name": "createdDate", "data": "createdDate", "targets": 16 },
                { "searchable": true, "orderable": true, "name": "updatedDate", "data": "updatedDate", "targets": 17 },
            ],
            initComplete: function () {
                this.api()
                .columns()
                .every(function () {
                    let column = this;
                    let title = column.footer().textContent;
                    // Create input element
                    let input = document.createElement('input');
                    input.placeholder = title;
                    column.footer().replaceChildren(input);
                    // Event listener for user input
                    input.addEventListener('keyup', () => {
                        if (column.search() !== this.value) {
                            column.search(input.value).draw();
                        }
                    });
                });
            }
        });
    })
  
</script>
