<script>
    $('ul#exampledropdownDropdown li:nth-child(1)').addClass("active");
    $('#PageheadGeneral').text('Invoices');

    $(document).ready(function () {

        $(function () {
            $(".datePicker").datepicker({
                dateFormat: 'dd/mm/y',//check change
                changeMonth: true,
                changeYear: true
            });
        });

        $("#sub_button").click(function () {
            var invoices = {
                // VatNo: $('#ddlVAT').val(),
                FromDate: $('#FromDate').val(),
                ToDate: $('#ToDate').val(),
            };
            var json = JSON.stringify(invoices);

            debugger;
            $.ajax({
                type: "POST",
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN",
                        $('input:hidden[name="__RequestVerificationToken"]').val());
                },
                url: "/Invoices?handler=InvoicePartial",
                data: invoices,
                success: function (data) {
                    console.log(data)
                    $('#btn_filters').trigger('click');
                    $("#sectionForInvoice").html(data);
                }
            });
        });

        $('#InvoicesTable').DataTable({
            "serverSide": true,
            "processing": true,
            "responsive": true,
            "filter": true,
            "paging": true,
            "orderCellsTop": true,
            "fixedHeader": true,
            "pagingType": 'full_numbers',
            "pageLength": 5,
            "lengthMenu": [5, 10, 20, 50, 100],
            "ajax": {
                url: "/Invoices?handler=InvoiceData",
                type: 'POST',
                // contentType: "application/json; charset=utf-8",
                // dataType: "json",
                // headers: { 'RequestVerificationToken': $('@Html.AntiForgeryToken()').val() }
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('@Html.AntiForgeryToken()').val());
                }
            },
            "columnDefs": [
                // {
                //     "targets": -1,
                //     "data": null,
                //     "render": function (data, type, row, meta) {
                //         return '<a href="/customers/edit?id=' + row.id + '">Edit</a> | <a href="/customers/details?id=' + row.id + '">Details</a> | <a href="/customers/delete?id=' + row.id + '">Delete</a>';
                //     },
                //     "sortable": false
                // },
                { "searchable": true, "orderable": true, "name": "irn", "data": "irn", "targets": 0, "width": "70px", "visible": true },
                { "searchable": false, "orderable": false, "name": "xmlFileName", "data": "xmlFileName", "width": "70px", "targets": 1 },
                { "searchable": true, "orderable": true, "name": "docType", "data": "docType", "width": "20px", "targets": 2 },
                { "searchable": true, "orderable": true, "name": "actionStatus", "data": "actionStatus", "width": "40px", "targets": 3 },
                { "searchable": true, "orderable": true, "name": "storeNo", "data": "storeNo", "width": "40px", "targets": 4 },
                { "searchable": true, "orderable": true, "name": "transactionDate", "data": "transactionDate", "width": "40px", "targets": 5 },
                { "searchable": false, "orderable": false, "name": "uuid", "data": "uuid", "width": "70px", "targets": 6 },
                { "searchable": true, "orderable": true, "name": "terminalNo", "data": "terminalNo", "width": "40px", "targets": 7 },
                { "searchable": true, "orderable": true, "name": "trxNo", "data": "trxNo", "width": "40px", "targets": 8 },
                { "searchable": true, "orderable": true, "name": "source", "data": "source", "width": "40px", "targets": 9 },
                // { "name": "TaxTotal", "data": "TaxTotal", "targets": 3 },
                { "searchable": false, "orderable": false, "name": "action", "data": "action", "width": "70px", "targets": 10 },
                { "searchable": false, "orderable": false, "name": "timeleftToReport", "data": "timeleftToReport", "width": "70px", "targets": 11 },
                { "searchable": false, "orderable": false, "name": "reportedIn", "data": "reportedIn", "width": "70px", "targets": 12 },
                { "searchable": false, "orderable": false, "name": "actionCount", "data": "actionCount", "width": "70px", "targets": 13 },
                { "searchable": false, "orderable": false, "name": "errorCount", "data": "errorCount", "width": "70px", "targets": 14 },
                { "searchable": false, "orderable": false, "name": "warningCount", "data": "warningCount", "width": "70px", "targets": 15 },
                { "searchable": false, "orderable": false, "name": "createdDate", "data": "createdDate", "width": "70px", "targets": 16 },
                { "searchable": false, "orderable": false, "name": "updatedDate", "data": "updatedDate", "width": "70px", "targets": 17 },
            ],
            initComplete: function () {
                var columns = this.api().init().columnDefs;
                this.api()
                    .columns()
                    .every(function (index) {
                        if (!columns[index] || columns[index].searchable) {
                            let column = this;
                            let title = column.footer().textContent;
                            debugger;
                            // Create input element
                            let input = document.createElement('input');
                            input.placeholder = title;
                            column.footer().replaceChildren(input);
                            // Event listener for user input
                            input.addEventListener('change', () => {
                                if (column.search() !== this.value) {
                                    column.search(input.value).draw();
                                }
                            });
                        }
                        else {
                            let column = this;
                            let title = column.footer().textContent;
                            debugger;
                            // Create input element
                            let input = document.createElement('input');
                            // input.placeholder = title;
                            input.readOnly = true;
                            column.footer().replaceChildren(input);
                            // Event listener for user input
                            input.addEventListener('change', () => {
                                if (column.search() !== this.value) {
                                    column.search(input.value).draw();
                                }
                            });
                            $('#InvoicesTable input[readonly]').css("border", "0");
                        }
                    });
            }
        });
    })

</script>
