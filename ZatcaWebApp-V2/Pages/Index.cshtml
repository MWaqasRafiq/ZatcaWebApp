@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";

    int submittedProgress = Convert.ToInt32(Model.dashboardChartData.TotalVatSubmitted / 
                            (Model.dashboardChartData.TotalVatSubmitted + 
                            Model.dashboardChartData.TotalVatFailed) * 100);

    int failedProgress = Convert.ToInt32(Model.dashboardChartData.TotalVatFailed /
                            (Model.dashboardChartData.TotalVatSubmitted +
                            Model.dashboardChartData.TotalVatFailed) * 100);

    int processedProgress = Convert.ToInt32(Model.dashboardChartData.VATProcessed /
                            (Model.dashboardChartData.VATProcessed +
                            Model.dashboardChartData.VATPending) * 100);

    int b2BProgress = Convert.ToInt32(Model.dashboardChartData.VatB2B /
                            (Model.dashboardChartData.VatB2B +
                            Model.dashboardChartData.VatB2C) * 100);
}

<section class="pb-0 pt-4">
    <div class="container-fluid">
        <div class="card mb-0">
            <div class="card-body">
                <div class="row gx-4 bg-white">
                    <!-- Item -->
                    <div class="col-xl-3 col-sm-6 py-4 border-lg-end border-gray-200">
                        <div class="d-flex align-items-center">
                            <div class="icon flex-shrink-0 bg-violet">
                                <i class="fa fa-solid fa-check"></i>
                                @*  <svg class="svg-icon svg-icon-sm svg-icon-heavy">
                                    <use xlink:href="#user-1"> </use>
                                </svg> *@
                            </div>
                            <div class="mx-3">
                                <h6 class="h4 fw-light text-gray-600 mb-1">VAT Submitted</h6>
                                <div class="number mb-1"><strong class="text-lg">@Convert.ToInt32(Model.dashboardChartData.TotalVatSubmitted)</strong></div>
                                <div class="progress" style="height: 4px" title="@(submittedProgress.ToString())%">
                                    <div class="progress-bar bg-violet" role="progressbar" style="width: @(submittedProgress.ToString())%; height: 4px;" aria-valuenow="@(submittedProgress.ToString())" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Item -->
                    <div class="col-xl-3 col-sm-6 py-4 border-lg-end border-gray-200">
                        <div class="d-flex align-items-center">
                            <div class="icon flex-shrink-0 bg-red">
                                <i class="fa fa-solid fa-exclamation"></i>
                               @*  <svg class="svg-icon svg-icon-sm svg-icon-heavy">
                                    <use xlink:href="#survey-1"> </use>
                                </svg> *@
                            </div>
                            <div class="mx-3">
                                <h6 class="h4 fw-light text-gray-600 mb-1">VAT Failed</h6>
                                <div class="number mb-1"><strong class="text-lg">@Convert.ToInt32(Model.dashboardChartData.TotalVatFailed)</strong></div>
                                <div class="progress" style="height: 4px" title="@(failedProgress.ToString())%">
                                    <div class="progress-bar bg-red" role="progressbar" style="width: @(failedProgress.ToString())%; height: 5px;" aria-valuenow="@(failedProgress.ToString())" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Item -->
                    <div class="col-xl-3 col-sm-6 py-4 border-lg-end border-gray-200">
                        <div class="d-flex align-items-center">
                            <div class="icon flex-shrink-0 bg-green">
                                <i class="fa fa-solid fa-heart"></i>
                             @*    <svg class="svg-icon svg-icon-sm svg-icon-heavy">
                                    <use xlink:href="#numbers-1"> </use>
                                </svg> *@
                            </div>
                            <div class="mx-3">
                                <h6 class="h4 fw-light text-gray-600 mb-1">VAT Processed</h6>
                                <div class="number mb-1"><strong class="text-lg">@Convert.ToInt32(Model.dashboardChartData.VATProcessed)</strong></div>
                                <div class="progress" style="height: 4px" title="@(processedProgress.ToString())%">
                                    <div class="progress-bar bg-green" role="progressbar" style="width: @(processedProgress.ToString())%; height: 5px;" aria-valuenow="@(processedProgress.ToString())" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Item -->
                    <div class="col-xl-3 col-sm-6 py-4">
                        <div class="d-flex align-items-center">
                            <div class="icon flex-shrink-0 bg-orange">
                                <i class="fa fa-solid fa-handshake"></i>
                              @*   <svg class="svg-icon svg-icon-sm svg-icon-heavy">
                                    <use xlink:href="#list-details-1"> </use>
                                </svg> *@
                            </div>
                            <div class="mx-3">
                                <h6 class="h4 fw-light text-gray-600 mb-1">VAT B2B</h6>
                                <div class="number mb-1"><strong class="text-lg">@Convert.ToInt32(Model.dashboardChartData.VatB2B)</strong></div>
                                <div class="progress" style="height: 4px" title="@(b2BProgress.ToString())%">
                                    <div class="progress-bar bg-orange" role="progressbar" style="width: @(b2BProgress.ToString())%; height: 5px;" aria-valuenow="@(b2BProgress.ToString())" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="pb-0 pt-2">
    <div class="container-fluid align-items-right">
        <div class="row">
            <div class="col-lg-6"> </div>
            <div class="col-lg-2" style="text-align:right; font-weight:600">
                <label class="pt-2" for="ddlVAT">VAT No:</label>
                </div>
            <div class="col-lg-4">
          @*       @Html.DropDownList("Dropwonlist", (IEnumerable<SelectListItem>)Model.VatNo, 
                new { @class = "form-control",id="ddlVAT" }) *@
                <form asp-page="/Index" method="post" id="dropDownForm" onchange="ddlVAT_Changed()">
                    <select class="form-select" id="ddlVAT" asp-for="ConnectionString">
                        @{
                            foreach (var i in Model.VatNo)
                            {
                                <option value="@i.Value">@i.Text</option>
                            }
                        }
                    </select>
                </form>
            </div>
        </div>
    </div>
</section>
<section class="charts pt-2">
    <div class="container-fluid">
        <div class="row gy-4 align-items-stretch">
            <!-- Pie Chart 1 -->
            <div class="col-lg-4">
                <div class="card mb-0">
                    @* <div class="card-header d-flex align-items-center">
                        <h5 class="h5 mb-0">Pie  Chart</h5>
                    </div> *@
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-12 mx-auto">
                                <div class="chartjs-size-monitor">
                                    <div class="chartjs-size-monitor-expand">
                                        <div class=""></div>
                                    </div>
                                    <div class="chartjs-size-monitor-shrink">
                                        <div class=""></div>
                                    </div>
                                </div>
                                <canvas id="pieChartTotalVat" width="400" height="400" style="display: block; width: 377px; height: 188px;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Pie Chart 2 -->
            <div class="col-lg-4">
                <div class="card mb-0">
                    @* <div class="card-header d-flex align-items-center">
                    <h5 class="h5 mb-0">Pie  Chart</h5>
                    </div> *@
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-12 mx-auto">
                                <div class="chartjs-size-monitor">
                                    <div class="chartjs-size-monitor-expand">
                                        <div class=""></div>
                                    </div>
                                    <div class="chartjs-size-monitor-shrink">
                                        <div class=""></div>
                                    </div>
                                </div>
                                <canvas id="pieChartVat" width="400" height="400" style="display: block; width: 377px; height: 188px;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
          
            <!-- Pie Chart 3 -->
            <div class="col-lg-4">
                <div class="card mb-0">
                    @* <div class="card-header d-flex align-items-center">
                    <h5 class="h5 mb-0">Pie  Chart</h5>
                    </div> *@
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-12 mx-auto">
                                <div class="chartjs-size-monitor">
                                    <div class="chartjs-size-monitor-expand">
                                        <div class=""></div>
                                    </div>
                                    <div class="chartjs-size-monitor-shrink">
                                        <div class=""></div>
                                    </div>
                                </div>
                                <canvas id="pieChartB2B" width="400" height="400" style="display: block; width: 377px; height: 188px;" class="chartjs-render-monitor"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
